JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://www.agri-ci.com
PAYMENT_WEBHOOK_SECRET=replace-only-after-licensed-provider-selection
